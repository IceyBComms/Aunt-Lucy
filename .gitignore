# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
frontend-dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Local environment (never commit real secrets — .env.example is the template)
# .env.* catches per-environment files such as .env.sandbox, which carry real
# connection strings and API keys; .env.example is the one deliberate exception.
.env
.env.*
!.env.example

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Rally app: index.html is the only committed HTML entry point. Ignore any
# other stray HTML (e.g. scratchpad mockups accidentally dropped into the app
# folder) so they can never be committed or served as part of the source.
/artifacts/rally/*.html
!/artifacts/rally/index.html

# Claude Code: launch.json defines how to start the dev server and is shared
# project config, so it is committed. settings.local.json is per-machine (a
# personal tool allowlist containing absolute paths) — never commit it.
.claude/settings.local.json

# Design handoff bundle: a ~789KB single-file export with every asset inlined
# as base64. Its reusable outputs are already tracked in source
# (components/PostmarkMark.tsx and public/favicon.svg), so keeping the bundle
# out avoids permanently bloating git history.
/attached_assets/Aunt Lucy Brand Assets.html

# ── Scratch at the repo root ────────────────────────────────────────────────
# Rehearsal artefacts land here: rendered preview pages (multi-MB, every image
# inlined as base64), the screenshots behind them, and stray pages/scripts
# dropped in while debugging. None of it is source, all of it is regenerable,
# and a single `git add .` would otherwise commit megabytes of it.
# Matched by PATTERN so the next preview is covered without another edit.
# Anchored with a leading slash: these apply to the repo root ONLY, so real
# source of the same extension deeper in the tree is untouched.
/*.html
/*.js
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.webp
# ...but a genuine root-level tool config must never be silently ignored.
!/*.config.js
!/*.config.mjs

# Preview harnesses: throwaway entry points that stub the API to render one
# real page in isolation. They import from src, so they have to live in src to
# resolve the @/ alias — but they are rehearsal scaffolding, never shipped.
# (The matching /artifacts/rally/*.html entry points are already covered above
# by the existing rally HTML rule.)
preview*.tsx

# Dated read-only reconciliation reports. Each one states in its own header
# that it is uncommitted and must stay that way; they are point-in-time audits,
# superseded by the next run, and the bug record in build/ is the durable one.
/RECONCILIATION_*.md
